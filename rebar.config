%% rebar.config — ITB LFE binding (thin proxy over the Erlang
%% binding's `itb3` module via native BEAM bytecode interop).
%%
%% The Erlang binding (bindings/erlang) is consumed as a rebar3
%% checkout dependency — the committed `_checkouts/libitb3` symlink is
%% rebar3's native path-dependency mechanism. Its compile pre-hook
%% builds the NIF shim (the only native code in the BEAM stack); the
%% shim links the C binding's static archive plus libitb3.so with an
%% embedded RPATH. ./build.sh builds libitb3.so and the C archive
%% before rebar3 compiles the checkout.
%%
%% The `lfe` hex dependency carries the LFE compiler (lfe_comp) that
%% the rebar3_lfe plugin drives; it is also the runtime library for
%% the compiled modules.

{erl_opts, [debug_info]}.

{deps, [
    {lfe, "2.2.0"},
    libitb3  %% resolved via the _checkouts/libitb3 symlink -> ../erlang
]}.

{plugins, [{rebar3_lfe, "0.5.8"}]}.

{provider_hooks, [{pre, [{compile, {lfe, compile}}]}]}.

{profiles, [
    {test, [{deps, [{ltest, "0.13.11"}]}]}
]}.

{eunit_opts, [verbose]}.

%% EUnit cannot auto-discover .lfe test sources (its scanner walks
%% .erl files only); the compiled test module is named explicitly.
{eunit_tests, [{module, 'itb-lfe-tests'}]}.
